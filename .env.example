# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
SESSION_TTL_HOURS=336
COOKIE_SECURE=false

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=documind_dev
# atlas = $vectorSearch + Atlas Search (production). local = dev-only bounded cosine scan.
VECTOR_BACKEND=local

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (S3-compatible) ----
# STORAGE_BACKEND=s3 for AWS S3/MinIO, local for dev filesystem storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local-data/objects
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=documind
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- AI providers (server-side only; never exposed to the browser) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
EMBEDDING_VERSION=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Uploads ----
MAX_UPLOAD_MB=50

# ---- Worker ----
WORKER_CONCURRENCY=2

# ---- Email ----
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DocuMind <no-reply@example.com>

# ---- Frontend (public values only!) ----
# Browser talks to Next.js; Next proxies /api to this URL server-side.
BACKEND_INTERNAL_URL=http://localhost:8000
TRUST_FORWARDED_FOR=false

# ---- Background jobs ----
# inline = run in the API process (dev without Redis). celery = Redis + worker (production).
JOB_BACKEND=inline
JOB_MAX_ATTEMPTS=3
MAX_FILES_PER_UPLOAD=20

# ---- Extraction / OCR ----
OCR_ENABLED=true
# Windows local dev: C:\Program Files\Tesseract-OCR\tesseract.exe (Docker image has it on PATH)
TESSERACT_CMD=tesseract
OCR_LANGS=eng
OCR_MAX_PAGES=200
MAX_PAGES_PER_DOCUMENT=2000

# ---- Embeddings ----
# openai = hosted (document text leaves the server: requires workspace consent)
# local  = sentence-transformers (pip install sentence-transformers; set EMBEDDING_MODEL=BAAI/bge-m3)
# hashing = deterministic test-only embedder (blocked in production)
EMBEDDING_BATCH_SIZE=64
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_S=60
LOCAL_VECTOR_SCAN_LIMIT=20000

# ---- LLM / RAG ----
# fake = deterministic extractive stand-in for tests/offline demos (blocked in production)
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096
# lexical | cross_encoder (needs sentence-transformers) | none
RERANKER=lexical
RAG_TOP_K=8
RAG_CANDIDATES=30
RAG_CONTEXT_TOKENS=6000
RAG_MIN_VECTOR_SCORE=0.2
RAG_MULTI_QUERY=true
RAG_HISTORY_TURNS=6

# ---- Document insights ----
INSIGHTS_ENABLED=true
INSIGHTS_MAX_DIRECT_CHARS=70000
INSIGHTS_WINDOW_CHARS=50000
